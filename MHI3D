def _nuslist_max_plus_one(nuslist_path, nsamples=None):
    """
    Parse nuslist (same rows as nuslist.used): first two columns are t_y, t_z.
    Ignore comments/extra columns. Return (size_y, size_z) = (max(t_y)+1, max(t_z)+1)
    over the first nsamples lines (or all if nsamples is None).
    """
    with open(nuslist_path, encoding=TEXT_ENCODING, errors="replace") as f:
        lines = f.readlines()
    if nsamples is not None:
        lines = lines[: int(nsamples)]
    max_y, max_z = -1, -1
    for line in lines:
        toks = line.split()
        if len(toks) < 2:
            continue
        try:
            ty, tz = int(toks[0]), int(toks[1])
        except ValueError:
            continue
        max_y = max(max_y, ty)
        max_z = max(max_z, tz)
    if max_y < 0 or max_z < 0:
        raise ValueError(f"no valid t_y,t_z rows in nuslist {nuslist_path}")
    return (max_y + 1, max_z + 1)


def _is_scratch_path_safe(scratch_base: str) -> bool:
    """Ensure scratch_base is under /scratch/ and never /, /scratch, or $HOME."""
    if not scratch_base or not isinstance(scratch_base, str):
        return False
    norm = os.path.normpath(scratch_base)
    if norm in ("/", "/scratch"):
        return False
    if not norm.startswith("/scratch/"):
        return False
    try:
        home = os.path.expanduser("~")
        if home and (norm == home or norm.startswith(home + os.sep)):
            return False
    except Exception:
        pass
    return True


def _scratch_base(cwd=None):
    """
    If /scratch/$(whoami) exists and username appears in cwd, return
    /scratch/$(whoami)/kg_proc/<path_after_username> (Option A). Else return None.
    """
    scratch_root = os.path.join("/scratch", getpass.getuser())
    if not os.path.isdir(scratch_root):
        return None
    cwd = os.path.abspath(cwd or os.getcwd())
    username = getpass.getuser()
    if username not in cwd:
        return None
    suffix = cwd.split(username, 1)[-1].lstrip(os.sep)
    if not suffix:
        return None
    base = os.path.join(scratch_root, "kg_proc", suffix)
    if not _is_scratch_path_safe(base):
        return None
    return base


def _is_valid_bruker3d(path: str, ser_file: str = "ser") -> bool:
    return Bruker3D(path, ser_file=ser_file).valid


def find_bruker_data_dir(dir_path: Optional[str], ser_file: str = "ser"):
    """Find directory containing valid Bruker 3D data."""
    return _find_bruker_data_dir(
        dir_path,
        lambda d: _is_valid_bruker3d(d, ser_file=ser_file),
    )


def load_saved_args():
    return _load_saved_args(Options)


def save_args(savedargs):
    try:
        _save_args(savedargs)
    except OSError as e:
        typer.echo(f"❌ Failed to save config: {e}", err=True)
        raise typer.Exit(1)

@app.command()
def convert(
    dir: Optional[str] = Option(None, "--dir", "-d", help="Data directory path"),
    nsamples: Optional[str] = Option(None, "--nsamples", "-n", help="Number of samples to convert (or 'all' for all samples)"),
    ser: str = Option('ser', "--ser", help="Name of the ser file")
):
    """Convert Bruker 3D data to nmrPipe format."""
    savedargs = load_saved_args()
    
    if dir:
        savedargs.dir = dir
    if not savedargs.dir:
        savedargs.dir = '.'
    
    # Find directory with valid Bruker data
    ser_file = getattr(savedargs, "ser", "ser")
    bruker_dir = find_bruker_data_dir(savedargs.dir, ser_file=ser_file)
    if not bruker_dir:
        typer.echo(f"❌ Error: No valid Bruker data found in '{savedargs.dir}' or '../'", err=True)
        typer.echo("   Required files: acqus, acqu2s, acqu3s, ser, pulseprogram (or pulseprogram.precomp), nuslist", err=True)
        raise typer.Exit(1)
    
    # Update savedargs.dir to the found directory
    if bruker_dir != savedargs.dir:
        typer.echo(f"🔍 Found Bruker data in '{bruker_dir}' (was looking in '{savedargs.dir}')")
        savedargs.dir = bruker_dir

    data = Bruker3D(savedargs.dir, ser_file=savedargs.ser)
    
    if nsamples:
        if nsamples.lower() == 'all':
            savedargs.nsamples = None  # Will use all samples from nuslist
        else:
            try:
                savedargs.nsamples = int(nsamples)
            except ValueError:
                typer.echo("❌ Error: nsamples must be a number or 'all'", err=True)
                raise typer.Exit(1)
    
    r = data.genConversion("convert.com", ns=int(savedargs.nsamples) if savedargs.nsamples else None)
    if r == 1:
        typer.echo("❌ Conversion failed!")
        raise typer.Exit(1)

    try:
        chmod_executable("convert.com")
        typer.echo("🔄 Converting Bruker 3D Data to nmrPipe Data Format (convert.com)")
        typer.echo("Started convert")
        t0 = time.perf_counter()
        run_cmd("./convert.com", check=True)
        typer.echo(f"Finished convert ({time.perf_counter() - t0:.1f} s)")
    except subprocess.CalledProcessError as e:
        typer.echo(f"❌ convert.com failed (exit {e.returncode})", err=True)
        raise typer.Exit(1)
    savedargs.beenConverted = True
    typer.echo("✅ Conversion completed successfully!")
    save_args(savedargs)

@app.command()
def phasecheck(
    dir: Optional[str] = Option(None, "--dir", "-d", help="Data directory path"),
    x_p0: Optional[float] = Option(None, "--xP0", help="X phase 0 correction"),
    x_p1: Optional[float] = Option(None, "--xP1", help="X phase 1 correction"),
    no_sol: bool = Option(False, "--noSOL", help="Skip solvent suppression"),
    ext_l: bool = Option(False, "--EXT_L", help="Extract left"),
    ext_r: bool = Option(False, "--EXT_R", help="Extract right"),
    ext_x1: Optional[float] = Option(None, "--EXT_x1", help="Extract x1"),
    ext_xn: Optional[float] = Option(None, "--EXT_xn", help="Extract xn"),
    x_zf: Optional[int] = Option(None, "--xZF", help="X dimension zero filling factor"),
    force: bool = Option(False, "--force", help="Bypass convert-state check and run phasecheck anyway")
):
    """Check phase correction in first dimension."""
    savedargs = load_saved_args()
    
    if not savedargs.beenConverted and not force:
        typer.echo("❌ Error: You need to convert the data from Bruker to nmrPipe format first", err=True)
        raise typer.Exit(1)
    if force and not savedargs.beenConverted:
        typer.echo("⚠️  --force enabled: running phasecheck without saved convert state")
    
    if dir:
        savedargs.dir = dir
    if not savedargs.dir:
        savedargs.dir = '.'
    
    savedargs.EXT_L = ext_l
    savedargs.EXT_R = ext_r
    savedargs.EXT_x1 = ext_x1
    savedargs.EXT_xn = ext_xn
    savedargs.noSOL = no_sol
    if x_zf:
        if not hasattr(savedargs, 'xZF'):
            savedargs.xZF = False
        savedargs.xZF = x_zf
    
    # Auto-detect if solvent suppression should be disabled based on direct dimension nucleus
    if not no_sol:  # Only auto-detect if user didn't explicitly set noSOL
        data = Bruker3D(savedargs.dir, ser_file=savedargs.ser)
        if data.valid and data.xLAB:
            # Remove the '_x' suffix for comparison
            nucleus = data.xLAB.replace('_x', '').upper()
            if nucleus not in ['1H', 'H']:
                savedargs.noSOL = True
                typer.echo(f"🔍 Direct dimension is {data.xLAB} - automatically disabling solvent suppression")
    
    if (ext_x1 is not None) != (ext_xn is not None):
        typer.echo("❌ Error: Must specify both EXT_x1 and EXT_xn", err=True)
        raise typer.Exit(1)
    
    # Always update phase values if provided on command line
    if x_p0 is not None:
        savedargs.phase0 = x_p0
    if x_p1 is not None:
        savedargs.phase1 = x_p1
    
    data = Bruker3D(savedargs.dir, ser_file=savedargs.ser)
    
    data.genDirectPhaseCheck('phase.com', 
                                phase0=savedargs.phase0, 
                                phase1=savedargs.phase1, 
                                ext=[savedargs.EXT_L, savedargs.EXT_R, savedargs.EXT_x1, savedargs.EXT_xn], 
                                sol=savedargs.noSOL,
                                x_zf=savedargs.xZF if hasattr(savedargs, 'xZF') else None)

    try:
        chmod_executable("phase.com")
        typer.echo("🔄 Transforming first Samples Point to test phases (phase.com)")
        typer.echo("Started phasecheck")
        t0 = time.perf_counter()
        run_cmd("./phase.com", check=True)
        typer.echo(f"Finished phasecheck ({time.perf_counter() - t0:.1f} s)")
    except subprocess.CalledProcessError as e:
        typer.echo(f"❌ phase.com failed (exit {e.returncode})", err=True)
        raise typer.Exit(1)
    run_cmd("nmrDraw -Ws 1000 700 -position 50 50 -in data001.dat", check=False)
    savedargs.beenPhased = True
    save_args(savedargs)

@app.command()
def reconstruct(
    nsamples: Optional[str] = Option(None, "--nsamples", "-n", help="Number of samples for reconstruction (or 'all' for all samples)"),
    sthr: Optional[float] = Option(0.98, "--sthr", help="Start threshold"),
    ethr: Optional[float] = Option(0.98, "--ethr", help="End threshold"),
    itr: Optional[int] = Option(None, "--itr", help="Iteration option"),
    y_n: Optional[int] = Option(None, "--yN", help="Y dimension size"),
    z_n: Optional[int] = Option(None, "--zN", help="Z dimension size"),
    auto_n: bool = Option(False, "--autoN", help="Auto N option"),
    x_zf: Optional[int] = Option(None, "--xZF", help="X dimension zero filling factor")
):
    """Reconstruct the 3D NMR data."""
    savedargs = load_saved_args()
    
    if not savedargs.beenPhased:
        typer.echo("❌ Error: You need to FT and phase the direct dimension first", err=True)
        raise typer.Exit(1)
    
    if not savedargs.dir:
        savedargs.dir = '.'
    
    
    # Check if directory exists
    if not os.path.exists(savedargs.dir):
        typer.echo(f"❌ Error: Directory '{savedargs.dir}' does not exist!", err=True)
        raise typer.Exit(1)
    
    if not os.path.isdir(savedargs.dir):
        typer.echo(f"❌ Error: '{savedargs.dir}' is not a directory!", err=True)
        raise typer.Exit(1)
    
    data = Bruker3D(savedargs.dir, ser_file=savedargs.ser)
    
    # Check if directory contains valid Bruker data
    if not data.valid:
        typer.echo(f"⚠️  Warning: Directory '{savedargs.dir}' does not contain valid Bruker 3D data.", err=True)
        typer.echo("   Required files: acqus, acqu2s, acqu3s, ser, pulseprogram (or pulseprogram.precomp), nuslist", err=True)
        typer.echo("   Please check that all required Bruker acquisition files are present.", err=True)
        raise typer.Exit(1)
    
    if nsamples:
        if nsamples.lower() == 'all':
            savedargs.nsamples = None  # Will use all samples from nuslist
        else:
            try:
                savedargs.nsamples = int(nsamples)
            except ValueError:
                typer.echo("❌ Error: nsamples must be a number or 'all'", err=True)
                raise typer.Exit(1)
    if sthr and ethr:
        savedargs.sthr = sthr
        savedargs.ethr = ethr
    else:
        savedargs.sthr = 0.98
        savedargs.ethr = 0.98
    
    # Auto-detect if solvent suppression should be disabled based on direct dimension nucleus
    # Only auto-detect if we haven't been through phasecheck yet
    if not savedargs.beenPhased:
        if not hasattr(savedargs, 'noSOL'):
            savedargs.noSOL = False  # Initialize to False if not set
        if not savedargs.noSOL:  # Only auto-detect if not already set to True
            if data.valid and data.xLAB:
                # Remove the '_x' suffix for comparison
                nucleus = data.xLAB.replace('_x', '').upper()
                if nucleus not in ['1H', 'H']:
                    savedargs.noSOL = True
                    typer.echo(f"🔍 Direct dimension is {data.xLAB} - automatically disabling solvent suppression")
    
    if itr:
        savedargs.itr = itr

    # Build nuslist.used in cwd (from Bruker nuslist) so we can derive max+1 from it when needed.
    shutil.copy(data.nuslist, "nuslist.copy")
    try:
        with open("nuslist.copy", encoding=TEXT_ENCODING, errors="replace") as f:
            content = f.readlines()
    except OSError as e:
        typer.echo(f"❌ Failed to read nuslist.copy: {e}", err=True)
        raise typer.Exit(1)
    if not savedargs.nsamples:
        shutil.copy("nuslist.copy", "nuslist.used")
    else:
        try:
            with open("nuslist.used", "w", encoding=TEXT_ENCODING) as outfile:
                for i in range(int(savedargs.nsamples)):
                    outfile.write(content[i])
        except OSError as e:
            typer.echo(f"❌ Failed to write nuslist.used: {e}", err=True)
            raise typer.Exit(1)

    if auto_n:
        savedargs.autoN = True
        savedargs.xN = 0
        savedargs.yN = 0
    else:
        # --yN and --zN work independently; when only one is given, derive the other from nuslist.used (max+1).
        # hmsIST requires both -xN and -yN when not using -autoN.
        if y_n is not None and z_n is not None:
            savedargs.xN = y_n
            savedargs.yN = z_n
        elif y_n is not None:
            try:
                size_y, size_z = _nuslist_max_plus_one('nuslist.used', None)
            except ValueError as e:
                typer.echo(f"❌ Error: {e}", err=True)
                raise typer.Exit(1)
            savedargs.xN = y_n
            savedargs.yN = size_z
        elif z_n is not None:
            try:
                size_y, size_z = _nuslist_max_plus_one('nuslist.used', None)
            except ValueError as e:
                typer.echo(f"❌ Error: {e}", err=True)
                raise typer.Exit(1)
            savedargs.xN = size_y
            savedargs.yN = z_n
    if x_zf:
        if not hasattr(savedargs, 'xZF'):
            savedargs.xZF = False
        savedargs.xZF = x_zf

    scratch_base = _scratch_base()
    use_scratch = False
    if scratch_base:
        run_cmd(f'rm -rf "{scratch_base}"', check=False)
        os.makedirs(os.path.join(scratch_base, "yzx"), exist_ok=True)
        os.makedirs(os.path.join(scratch_base, "yzx_ist"), exist_ok=True)
        os.makedirs(os.path.join(scratch_base, "rec"), exist_ok=True)
        run_cmd("rm -rf yzx yzx_ist rec", check=False)
        os.symlink(os.path.join(scratch_base, "yzx"), "yzx")
        os.symlink(os.path.join(scratch_base, "yzx_ist"), "yzx_ist")
        os.symlink(os.path.join(scratch_base, "rec"), "rec")
        use_scratch = True
        savedargs.scratch_base = scratch_base
        typer.echo(f"📁 Using scratch disk: {scratch_base}")
    else:
        savedargs.scratch_base = None

    data.genPrepare(
        "prepare4recon.com",
        phase0=savedargs.phase0,
        phase1=savedargs.phase1,
        ext=[savedargs.EXT_L, savedargs.EXT_R, savedargs.EXT_x1, savedargs.EXT_xn],
        sol=savedargs.noSOL,
        x_zf=savedargs.xZF if hasattr(savedargs, "xZF") else None,
        use_scratch=use_scratch,
    )
    try:
        chmod_executable("prepare4recon.com")
        typer.echo("🔄 Preparing Sampled Points for Full Reconstruction (prepare4recon.com)")
        typer.echo("Started prepare4recon")
        t0 = time.perf_counter()
        run_cmd("./prepare4recon.com", check=True)
        typer.echo(f"Finished prepare4recon ({time.perf_counter() - t0:.1f} s)")
    except subprocess.CalledProcessError as e:
        typer.echo(f"❌ prepare4recon.com failed (exit {e.returncode})", err=True)
        raise typer.Exit(1)

    _xN = savedargs.xN if (savedargs.xN is not False and savedargs.xN is not None) else 0
    _yN = savedargs.yN if (savedargs.yN is not False and savedargs.yN is not None) else 0
    data.genRecon(
        ["recon.py", "hmsist.com", "prepare4ft.com"],
        proc=0,
        itr=savedargs.itr,
        xN=_xN,
        yN=_yN,
        sthr=savedargs.sthr,
        ethr=savedargs.ethr,
    )
    chmod_executable("recon.py", "hmsist.com", "prepare4ft.com")
    typer.echo("🔄 Performing Reconstruction (recon.py / hmsist.com)")
    if not use_scratch and not os.path.isdir("yzx_ist"):
        os.makedirs("yzx_ist", exist_ok=True)

    try:
        typer.echo("Started recon")
        t0 = time.perf_counter()
        run_cmd("./recon.py yzx/", check=True)
        typer.echo(f"Finished recon ({time.perf_counter() - t0:.1f} s)")
    except subprocess.CalledProcessError as e:
        typer.echo(f"❌ recon.py failed (exit {e.returncode})", err=True)
        raise typer.Exit(1)
    typer.echo("🔄 Moving from PHF to standard nmrPipe data order (prepare4ft.com)")
    try:
        typer.echo("Started prepare4ft")
        t0 = time.perf_counter()
        run_cmd("./prepare4ft.com", check=True)
        typer.echo(f"Finished prepare4ft ({time.perf_counter() - t0:.1f} s)")
    except subprocess.CalledProcessError as e:
        typer.echo(f"❌ prepare4ft.com failed (exit {e.returncode})", err=True)
        raise typer.Exit(1)
    savedargs.beenReconed = True
    
    typer.echo("✅ Reconstruction completed successfully!")
    
    save_args(savedargs)

@app.command()
def ft(
    triplerez: bool = Option(False, "--triplerez", help="Assume processing params for standard Bruker triple resonance experiments"),
    xyz: bool = Option(False, "--xyz", help="Output nmrPipe xyz format in addition to 3Dspectrum.dat"),
    y_p0: Optional[float] = Option(None, "--yP0", help="Y phase 0"),
    y_p1: Optional[float] = Option(None, "--yP1", help="Y phase 1"),
    z_p0: Optional[float] = Option(None, "--zP0", help="Z phase 0"),
    z_p1: Optional[float] = Option(None, "--zP1", help="Z phase 1"),
    y_zf: Optional[int] = Option(None, "--yZF", help="Y dimension zero filling factor"),
    z_zf: Optional[int] = Option(None, "--zZF", help="Z dimension zero filling factor"),
    no_draw: bool = Option(False, "--noDraw", help="Skip launching nmrDraw for 2D projections")
):
    """Perform final Fourier transform of indirect dimensions."""
    savedargs = load_saved_args()
    
    if not savedargs.beenReconed:
        typer.echo("❌ Error: You need to do a reconstruction of the data before the final FT", err=True)
        raise typer.Exit(1)
    
    if not savedargs.dir:
        savedargs.dir = '.'
    
    savedargs.triplerez = triplerez
    savedargs.xyz = xyz
    savedargs.yP0 = y_p0
    savedargs.yP1 = y_p1
    savedargs.zP0 = z_p0
    savedargs.zP1 = z_p1
    if y_zf:
        if not hasattr(savedargs, 'yZF'):
            savedargs.yZF = False
        savedargs.yZF = y_zf
    if z_zf:
        if not hasattr(savedargs, 'zZF'):
            savedargs.zZF = False
        savedargs.zZF = z_zf

    data = Bruker3D(savedargs.dir, ser_file=savedargs.ser)
    data.genFT('ft.com', triplerez=savedargs.triplerez, yACQ=data.yACQ, zACQ=data.zACQ, 
               xyz=savedargs.xyz, yP0=savedargs.yP0, zP0=savedargs.zP0, yP1=savedargs.yP1, zP1=savedargs.zP1,
               y_zf=savedargs.yZF if hasattr(savedargs, 'yZF') else None,
               z_zf=savedargs.zZF if hasattr(savedargs, 'zZF') else None)
    try:
        chmod_executable("ft.com")
        typer.echo("🔄 Performing Indirect Fourier Transforms (ft.com)")
        typer.echo("Started ft")
        t0 = time.perf_counter()
        run_cmd("./ft.com", check=True)
        typer.echo(f"Finished ft ({time.perf_counter() - t0:.1f} s)")
    except subprocess.CalledProcessError as e:
        typer.echo(f"❌ ft.com failed (exit {e.returncode})", err=True)
        raise typer.Exit(1)
    savedargs.beenFT = True
    
    # Detect and report the generated files
    typer.echo("📁 Generated files:")
    
    # Check for 3Dspectrum.dat
    if os.path.exists('3Dspectrum.dat'):
        typer.echo("  ✅ 3Dspectrum.dat")
    else:
        typer.echo("  ❌ 3Dspectrum.dat (not found)")
    
    
    typer.echo("✅ Final Fourier transform completed successfully!")
    
    excluded = {"3Dspectrum.dat", "data001.dat"}
    projection_files = [f for f in glob.glob("*.dat") if f not in excluded]
    if projection_files:
        typer.echo("  📊 2D Projections:")
        for file in sorted(projection_files):
            typer.echo(f"    • {file}")
        if not no_draw:
            typer.echo("🖥️  Launching nmrDraw windows for projections...")
            for fn, file in enumerate(sorted(projection_files)):
                typer.echo(f"  Opening {file} in nmrDraw...")
                cmd = f"nmrDraw -Ws 1000 700 -position {50 + fn * 50} {50 + fn * 50} -in {file}"
                if fn < len(projection_files) - 1:
                    cmd += " &"
                run_cmd(cmd, check=False)
    else:
        typer.echo("  ❌ No 2D projection files found")
    
    
    
    save_args(savedargs)

@app.command()
