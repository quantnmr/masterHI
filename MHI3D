        typer.echo(f"Removed scratch: {scratch_base}")
        savedargs.scratch_base = None
        save_args(savedargs)
    run_cmd("rm -rf data001.dat yzx yzx_ist fid rec", check=False)
    typer.echo("Cleaning completed.")


@app.command()
def workflow(
    dir: str = Option(..., "--dir", "-d", help="Data directory path"),
    nsamples: Optional[str] = Option(None, "--nsamples", "-n", help="Number of samples (or 'all' for all)"),
    ser: str = Option("ser", "--ser", help="Name of the ser file"),
    # phasecheck
    x_p0: Optional[float] = Option(None, "--xP0", help="X phase 0 correction"),
    x_p1: Optional[float] = Option(None, "--xP1", help="X phase 1 correction"),
    no_sol: bool = Option(False, "--noSOL", help="Skip solvent suppression"),
    ext_l: bool = Option(False, "--EXT_L", help="Extract left"),
    ext_r: bool = Option(False, "--EXT_R", help="Extract right"),
    ext_x1: Optional[float] = Option(None, "--EXT_x1", help="Extract x1"),
    ext_xn: Optional[float] = Option(None, "--EXT_xn", help="Extract xn"),
    x_zf: Optional[int] = Option(None, "--xZF", help="X dimension zero filling factor"),
    # reconstruct
    sthr: Optional[float] = Option(0.98, "--sthr", help="Start threshold"),
    ethr: Optional[float] = Option(0.98, "--ethr", help="End threshold"),
    itr: Optional[int] = Option(None, "--itr", help="Iteration option"),
    y_n: Optional[int] = Option(None, "--yN", help="Y dimension size"),
    z_n: Optional[int] = Option(None, "--zN", help="Z dimension size"),
    auto_n: bool = Option(False, "--autoN", help="Auto N option"),
    # ft
    triplerez: bool = Option(False, "--triplerez", help="Triple resonance processing"),
    xyz: bool = Option(False, "--xyz", help="Output nmrPipe xyz format"),
    y_p0: Optional[float] = Option(None, "--yP0", help="Y phase 0"),
    y_p1: Optional[float] = Option(None, "--yP1", help="Y phase 1"),
    z_p0: Optional[float] = Option(None, "--zP0", help="Z phase 0"),
    z_p1: Optional[float] = Option(None, "--zP1", help="Z phase 1"),
    y_zf: Optional[int] = Option(None, "--yZF", help="Y zero filling"),
    z_zf: Optional[int] = Option(None, "--zZF", help="Z zero filling"),
    no_draw: bool = Option(False, "--noDraw", help="Skip launching nmrDraw after FT"),
    # partial run
    convert_only: bool = Option(False, "--convert-only", help="Only run conversion"),
    phasecheck_only: bool = Option(False, "--phasecheck-only", help="Run convert + phasecheck, then stop"),
    reconstruct_only: bool = Option(False, "--reconstruct-only", help="Only run reconstruction"),
    ft_only: bool = Option(False, "--ft-only", help="Only run final Fourier transform"),
):
    """Run convert → phasecheck → reconstruct → ft in sequence."""
    only_flags = [convert_only, phasecheck_only, reconstruct_only, ft_only]
    if sum(only_flags) > 1:
        typer.echo("❌ Use at most one of --convert-only, --phasecheck-only, --reconstruct-only, --ft-only", err=True)
        raise typer.Exit(1)

    if ft_only:
        savedargs = load_saved_args()
        savedargs.dir = dir
        save_args(savedargs)
        typer.echo("🔄 Workflow (ft only)")
        ft(triplerez=triplerez, xyz=xyz, y_p0=y_p0, y_p1=y_p1,
           z_p0=z_p0, z_p1=z_p1, y_zf=y_zf, z_zf=z_zf, no_draw=no_draw)
        typer.echo("🎉 Workflow completed!")
        return

    if reconstruct_only:
        savedargs = load_saved_args()
        savedargs.dir = dir
        save_args(savedargs)
        typer.echo("🔄 Workflow (reconstruct only)")
        reconstruct(nsamples=nsamples, sthr=sthr, ethr=ethr, itr=itr,
                    y_n=y_n, z_n=z_n, auto_n=auto_n, x_zf=x_zf)
        typer.echo("🎉 Workflow completed!")
        return

    if convert_only:
        typer.echo("🔄 Workflow (convert only)")
        convert(dir=dir, nsamples=nsamples, ser=ser)
        typer.echo("🎉 Workflow completed!")
        return

    if phasecheck_only:
        typer.echo("🔄 Workflow (convert + phasecheck)")
        convert(dir=dir, nsamples=nsamples, ser=ser)
        phasecheck(dir=dir, x_p0=x_p0, x_p1=x_p1, no_sol=no_sol,
                   ext_l=ext_l, ext_r=ext_r, ext_x1=ext_x1, ext_xn=ext_xn, x_zf=x_zf)
        typer.echo("🎉 Workflow completed!")
        return

    typer.echo("🔄 Workflow (convert → phasecheck → reconstruct → ft)")
    convert(dir=dir, nsamples=nsamples, ser=ser)
    phasecheck(dir=dir, x_p0=x_p0, x_p1=x_p1, no_sol=no_sol,
               ext_l=ext_l, ext_r=ext_r, ext_x1=ext_x1, ext_xn=ext_xn, x_zf=x_zf)
    reconstruct(nsamples=nsamples, sthr=sthr, ethr=ethr, itr=itr,
                y_n=y_n, z_n=z_n, auto_n=auto_n, x_zf=x_zf)
    ft(triplerez=triplerez, xyz=xyz, y_p0=y_p0, y_p1=y_p1,
